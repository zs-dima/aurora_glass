{
  // The gallery is a separate app in `example/`, resolved on its own, so its entry point is given
  // as a path from this folder rather than through `cwd`.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Gallery",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "cwd": "${workspaceFolder}/example",
      "console": "debugConsole"
    },
    {
      "name": "Gallery (Windows)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "cwd": "${workspaceFolder}/example",
      "deviceId": "windows",
      "console": "debugConsole"
    },
    {
      "name": "Gallery (Chrome)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "cwd": "${workspaceFolder}/example",
      "deviceId": "chrome",
      "console": "debugConsole"
    },
    {
      "name": "Tests",
      "request": "launch",
      "type": "dart",
      "program": "test/",
      "console": "debugConsole",
      "args": [
        "--reporter=expanded"
      ]
    }
  ]
}